{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TaskAPI",
  "colors": {
    "primary": "03A062",
    "light": "#000050",
    "dark": "03A062"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "icon": "book-open-cover",
          "href": "https://mintlify.com/docs"
        },
        {
          "anchor": "Blog",
          "icon": "newspaper",
          "href": "https://mintlify.com/blog"
        }
      ]
    },
    "pages": [
      "home",
      {
        "group": "Getting Started",
        "pages": [
          "testing",
          "concepts",
          "troubleshoot"
        ]
      },
      {
        "group": "API Reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "navbar": {
    "links": [
      {
        "href": "mailto:support@mintlify.com",
